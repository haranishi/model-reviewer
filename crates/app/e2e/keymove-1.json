{
  "timeout_secs": 30,
  "steps": [
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "empty.new" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "tool.shape" },
    { "op": "click_widget", "name": "shape.cube" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "inspector.pos.x" },
    { "op": "type_text", "text": "12.5" },
    { "op": "key", "key": "Enter" },
    { "op": "dump_state", "path": "keymove-1-reference.json" },
    { "op": "key", "key": "Z", "modifiers": ["command"] },
    { "op": "key", "key": "G" },
    { "op": "key", "key": "X" },
    { "op": "key", "key": "1" },
    { "op": "key", "key": "2" },
    { "op": "key", "key": "Period" },
    { "op": "key", "key": "5" },
    { "op": "dump_state", "path": "keymove-1-entry.json" },
    { "op": "key", "key": "Enter" },
    { "op": "assert_state_equals", "path": "keymove-1-reference.json", "relative_to": "out" },
    { "op": "key", "key": "ArrowRight" },
    { "op": "key", "key": "ArrowUp" },
    { "op": "key", "key": "ArrowRight", "modifiers": ["shift"] },
    { "op": "dump_state", "path": "keymove-1-nudged.json" },
    { "op": "key", "key": "Z", "modifiers": ["command"] },
    { "op": "key", "key": "Z", "modifiers": ["command"] },
    { "op": "key", "key": "Z", "modifiers": ["command"] },
    { "op": "assert_state_equals", "path": "keymove-1-reference.json", "relative_to": "out" },
    { "op": "key", "key": "R" },
    { "op": "key", "key": "Y" },
    { "op": "key", "key": "9" },
    { "op": "key", "key": "0" },
    { "op": "key", "key": "Enter" },
    { "op": "key", "key": "S" },
    { "op": "dump_state", "path": "keymove-1-before-scale.json" },
    { "op": "key", "key": "Z" },
    { "op": "key", "key": "2" },
    { "op": "key", "key": "Escape" },
    { "op": "assert_state_equals", "path": "keymove-1-before-scale.json", "relative_to": "out" },
    { "op": "dump_state", "path": "keymove-1-state.json" },
    { "op": "quit" }
  ]
}
