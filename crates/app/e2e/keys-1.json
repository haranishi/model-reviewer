{
  "timeout_secs": 30,
  "steps": [
    { "op": "open_model", "path": "../../../assets/samples/review-sample.glb" },
    { "op": "wait_idle" },
    { "op": "dump_state", "path": "keys-default-select.json" },
    { "op": "click_widget", "name": "tool.move" },
    { "op": "dump_state", "path": "keys-default-move.json" },
    { "op": "click_widget", "name": "tool.select" },
    { "op": "click_widget", "name": "toolbar.help" },
    { "op": "click_widget", "name": "help.keys" },
    { "op": "sample", "label": "設定の初期表示", "frames": 4 },
    { "op": "screenshot", "path": "keys-1-default.png" },
    { "op": "click_widget", "name": "keys.filter" },
    { "op": "type_text", "text": "移動" },
    { "op": "click_widget", "name": "keys.row.tool.move" },
    { "op": "sample", "label": "取り込み中", "frames": 4 },
    { "op": "screenshot", "path": "keys-1-capture.png" },
    { "op": "key", "key": "ArrowRight" },
    { "op": "sample", "label": "断った理由", "frames": 4 },
    { "op": "screenshot", "path": "keys-1-refused.png" },
    { "op": "key", "key": "T" },
    { "op": "dump_state", "path": "keys-1-assigned.json" },
    { "op": "click_widget", "name": "keys.close" },
    { "op": "dump_state", "path": "keys-1-select.json" },
    { "op": "click_widget", "name": "tool.move" },
    { "op": "dump_state", "path": "keys-1-move.json" },
    { "op": "click_widget", "name": "tool.select" },
    { "op": "key", "key": "G" },
    { "op": "assert_state_equals", "path": "keys-1-select.json", "relative_to": "out" },
    { "op": "key", "key": "T" },
    { "op": "assert_state_equals", "path": "keys-1-move.json", "relative_to": "out" },
    { "op": "click_widget", "name": "toolbar.help" },
    { "op": "click_widget", "name": "help.keys" },
    { "op": "click_widget", "name": "keys.filter" },
    { "op": "key", "key": "A", "modifiers": ["command"] },
    { "op": "type_text", "text": "回転" },
    { "op": "click_widget", "name": "keys.row.tool.rotate" },
    { "op": "key", "key": "T" },
    { "op": "sample", "label": "重なりの確認", "frames": 4 },
    { "op": "screenshot", "path": "keys-1-conflict.png" },
    { "op": "dump_state", "path": "keys-1-conflict.json" },
    { "op": "click_widget", "name": "keys.conflict.cancel" },
    { "op": "sample", "label": "重なりを取り消した後", "frames": 4 },
    { "op": "screenshot", "path": "keys-1.png" },
    { "op": "click_widget", "name": "keys.close" },
    { "op": "click_widget", "name": "tool.select" },
    { "op": "assert_state_equals", "path": "keys-1-select.json", "relative_to": "out" },
    { "op": "dump_state", "path": "keys-1-state.json" },
    { "op": "quit" }
  ]
}
