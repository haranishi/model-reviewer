{
  "timeout_secs": 30,
  "steps": [
    { "op": "open_model", "path": "../../../assets/samples/review-sample.glb" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "tool.measure" },
    { "op": "hover_view", "at": [0.248, 0.58] },
    { "op": "screenshot", "path": "inspect-1-candidate.png" },
    { "op": "click_view", "at": [0.248, 0.58] },
    { "op": "click_view", "at": [0.734, 0.539] },
    { "op": "screenshot", "path": "inspect-1-measure.png" },
    { "op": "dump_state", "path": "inspect-1-measure.json" },
    { "op": "key", "key": "X" },
    { "op": "click_view", "at": [0.248, 0.58] },
    { "op": "dump_state", "path": "inspect-1-face.json" },
    { "op": "key", "key": "X" },
    { "op": "key", "key": "Escape" },
    { "op": "key", "key": "Escape" },
    { "op": "key", "key": "C" },
    { "op": "screenshot", "path": "inspect-1-section-z.png" },
    { "op": "click_widget", "name": "section.axis.y" },
    { "op": "click_widget", "name": "section.offset" },
    { "op": "type_text", "text": "0.6" },
    { "op": "key", "key": "Enter" },
    { "op": "click_widget", "name": "section.flip" },
    { "op": "screenshot", "path": "inspect-1-section-flipped.png" },
    { "op": "click_widget", "name": "section.flip" },
    { "op": "click_view", "at": [0.378, 0.527] },
    { "op": "screenshot", "path": "inspect-1-section-select.png" },
    { "op": "dump_state", "path": "inspect-1-section.json" },
    { "op": "click_widget", "name": "status.display_unit" },
    { "op": "click_widget", "name": "tool.measure" },
    { "op": "hover_view", "at": [0.6, 0.62] },
    { "op": "screenshot", "path": "inspect-1-mm.png" },
    { "op": "dump_state", "path": "inspect-1-mm.json" },
    { "op": "quit" }
  ]
}
