{
  "timeout_secs": 30,
  "steps": [
    { "op": "open_model", "path": "../../../assets/samples/review-sample.stl", "stl_up": "y" },
    { "op": "wait_idle" },
    { "op": "screenshot", "path": "stl-1-open.png" },
    { "op": "save_review", "path": "stl-1-source-review.json" },
    { "op": "dump_state", "path": "stl-1-open.json" },
    { "op": "click_widget", "name": "tool.measure" },
    { "op": "hover_view", "at": [0.202, 0.808] },
    { "op": "click_view", "at": [0.202, 0.808] },
    { "op": "click_view", "at": [0.438, 0.938] },
    { "op": "screenshot", "path": "stl-1-measure.png" },
    { "op": "dump_state", "path": "stl-1-measure.json" },
    { "op": "key", "key": "Escape" },
    { "op": "key", "key": "Escape" },
    { "op": "click_widget", "name": "toolbar.annotate" },
    { "op": "click_view", "at": [0.3, 0.5] },
    { "op": "click_widget", "name": "draft.text" },
    { "op": "type_text", "text": "角の面取りを確認" },
    { "op": "click_widget", "name": "draft.commit" },
    { "op": "key", "key": "Escape" },
    { "op": "click_widget", "name": "tool.shape" },
    { "op": "click_widget", "name": "shape.cylinder" },
    { "op": "click_widget", "name": "dims.d" },
    { "op": "type_text", "text": "10" },
    { "op": "key", "key": "Enter" },
    { "op": "click_widget", "name": "dims.h" },
    { "op": "type_text", "text": "15" },
    { "op": "key", "key": "Enter" },
    { "op": "screenshot", "path": "stl-1-dims.png" },
    { "op": "dump_state", "path": "stl-1-dims.json" },
    { "op": "export_glb", "path": "stl-1.glb" },
    { "op": "wait_idle" },
    { "op": "screenshot", "path": "stl-1-exported.png" },
    { "op": "click_widget", "name": "dialog.cancel" },
    { "op": "save_review", "path": "stl-1-review.json" },
    { "op": "key", "key": "Escape" },
    { "op": "key", "key": "Escape" },
    { "op": "click_widget", "name": "toolbar.home" },
    { "op": "screenshot", "path": "stl-1.png" },
    { "op": "dump_state", "path": "stl-1-state.json" },
    { "op": "quit" }
  ]
}
