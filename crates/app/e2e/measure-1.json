{
  "timeout_secs": 30,
  "steps": [
    { "op": "open_model", "path": "../../../assets/samples/review-sample.glb" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "tool.measure" },
    { "op": "click_view", "at": [0.5, 0.5] },
    { "op": "click_view", "at": [0.6, 0.62] },
    { "op": "screenshot", "path": "measure-1.png" },
    { "op": "dump_state", "path": "measure-1.json" },
    { "op": "click_widget", "name": "parts.row.1" },
    { "op": "click_widget", "name": "inspector.pos.y" },
    { "op": "type_text", "text": "0.9" },
    { "op": "key", "key": "Enter" },
    { "op": "dump_state", "path": "measure-2.json" },
    { "op": "click_widget", "name": "status.unit" },
    { "op": "screenshot", "path": "measure-2-cm.png" },
    { "op": "dump_state", "path": "measure-3.json" },
    { "op": "click_widget", "name": "toolbar.undo" },
    { "op": "key", "key": "Escape" },
    { "op": "click_view", "at": [0.5, 0.5] },
    { "op": "dump_state", "path": "measure-persp.json" },
    { "op": "click_widget", "name": "view.projection.orthographic" },
    { "op": "key", "key": "Escape" },
    { "op": "click_view", "at": [0.5, 0.5] },
    { "op": "click_view", "at": [0.6, 0.62] },
    { "op": "screenshot", "path": "measure-ortho.png" },
    { "op": "dump_state", "path": "measure-ortho.json" },
    { "op": "key", "key": "Escape" },
    { "op": "key", "key": "Escape" },
    { "op": "screenshot", "path": "measure-cleared.png" },
    { "op": "dump_state", "path": "measure-cleared.json" },
    { "op": "quit" }
  ]
}
