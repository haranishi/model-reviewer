{
  "timeout_secs": 30,
  "steps": [
    { "op": "click_widget", "name": "empty.new" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "tool.shape" },
    { "op": "click_widget", "name": "shape.cube" },
    { "op": "wait_idle" },
    { "op": "paste_texture", "path": "../../../target/tex/quadrants.png" },
    { "op": "wait_idle" },
    { "op": "dump_state", "path": "tex-2-pasted.json" },
    { "op": "click_widget", "name": "texture.size" },
    { "op": "key", "key": "A", "modifiers": ["command"] },
    { "op": "type_text", "text": "0.25" },
    { "op": "key", "key": "Enter" },
    { "op": "dump_state", "path": "tex-2-sized.json" },
    { "op": "click_widget", "name": "toolbar.undo" },
    { "op": "assert_state_equals", "path": "tex-2-pasted.json", "relative_to": "out" },
    { "op": "click_widget", "name": "toolbar.redo" },
    { "op": "assert_state_equals", "path": "tex-2-sized.json", "relative_to": "out" },
    { "op": "key", "key": "D", "modifiers": ["command"] },
    { "op": "dump_state", "path": "tex-2-copy.json" },
    { "op": "export_glb", "path": "tex-2.glb" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "dialog.cancel" },
    { "op": "open_model", "path": "tex-2.glb", "relative_to": "out" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "parts.row.0" },
    { "op": "dump_state", "path": "tex-2-original-reopened.json" },
    { "op": "click_widget", "name": "parts.row.1" },
    { "op": "dump_state", "path": "tex-2-copy-reopened.json" },
    { "op": "quit" }
  ]
}
