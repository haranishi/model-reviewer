{
  "timeout_secs": 30,
  "steps": [
    {
      "op": "open_model",
      "path": "../../../assets/samples/review-sample.glb"
    },
    {
      "op": "wait_idle"
    },
    {
      "op": "drag_view",
      "from": [0.48, 0.5],
      "to": [0.56, 0.47],
      "button": "primary",
      "frames": 6
    },
    {
      "op": "drag_view",
      "from": [0.5, 0.5],
      "to": [0.52, 0.51],
      "button": "secondary",
      "frames": 4
    },
    {
      "op": "scroll_view",
      "at": [0.5, 0.5],
      "delta": [0, 24]
    },
    {
      "op": "click_view",
      "at": [0.5, 0.5]
    },
    {
      "op": "key",
      "key": "H"
    },
    {
      "op": "click_widget",
      "name": "toolbar.annotate"
    },
    {
      "op": "click_view",
      "at": [0.52, 0.6]
    },
    {
      "op": "click_widget",
      "name": "draft.text"
    },
    {
      "op": "type_text",
      "text": "先端"
    },
    {
      "op": "click_widget",
      "name": "draft.commit"
    },
    {
      "op": "click_widget",
      "name": "views.name"
    },
    {
      "op": "type_text",
      "text": "確認"
    },
    {
      "op": "click_widget",
      "name": "views.save"
    },
    {
      "op": "save_review",
      "path": "review.json",
      "relative_to": "out"
    },
    {
      "op": "screenshot",
      "path": "flow-1.png"
    },
    {
      "op": "key",
      "key": "Escape"
    },
    {
      "op": "key",
      "key": "Escape"
    },
    {
      "op": "dump_state",
      "path": "state.json"
    },
    {
      "op": "quit"
    }
  ]
}

