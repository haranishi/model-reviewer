    { "op": "click_widget", "name": "dialog.cancel" },
    { "op": "open_model", "path": "tex-3.glb", "relative_to": "out" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "parts.row.0" },
    { "op": "dump_state", "path": "tex-3-reopened.json" },
    { "op": "quit" }
  ]
