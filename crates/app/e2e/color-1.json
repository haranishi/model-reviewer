{
  "timeout_secs": 30,
  "steps": [
    { "op": "open_model", "path": "../../../assets/samples/review-sample.glb" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "parts.row.3" },
    { "op": "dump_state", "path": "color-1-original.json" },
    { "op": "click_widget", "name": "color.swatch.4" },
    { "op": "dump_state", "path": "color-1-red.json" },
    { "op": "click_widget", "name": "toolbar.undo" },
    { "op": "assert_state_equals", "path": "color-1-original.json", "relative_to": "out" },
    { "op": "click_widget", "name": "toolbar.redo" },
    { "op": "assert_state_equals", "path": "color-1-red.json", "relative_to": "out" },
    { "op": "click_widget", "name": "color.swatch.9" },
    { "op": "dump_state", "path": "color-1-blue-reference.json" },
    { "op": "click_widget", "name": "toolbar.undo" },
    { "op": "click_widget", "name": "color.hex" },
    { "op": "key", "key": "A", "modifiers": ["command"] },
    { "op": "type_text", "text": "3D7BD9" },
    { "op": "key", "key": "Enter" },
