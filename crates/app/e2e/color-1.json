    { "op": "key", "key": "D", "modifiers": ["command"] },
    { "op": "click_widget", "name": "color.swatch.6" },
    { "op": "key", "key": "G" },
    { "op": "key", "key": "X" },
    { "op": "key", "key": "1" },
    { "op": "key", "key": "Enter" },
    { "op": "click_widget", "name": "tool.select" },
    { "op": "export_glb", "path": "color-1.glb" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "dialog.cancel" },
    { "op": "click_widget", "name": "toolbar.home" },
    { "op": "dump_state", "path": "color-1-copy.json" },
    { "op": "click_widget", "name": "parts.row.3" },
    { "op": "dump_state", "path": "color-1-blue.json" },
    { "op": "open_model", "path": "color-1.glb", "relative_to": "out" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "parts.row.3" },
    { "op": "assert_state_equals", "path": "color-1-blue.json", "relative_to": "out" },
    { "op": "click_widget", "name": "parts.row.4" },
    { "op": "assert_state_equals", "path": "color-1-copy.json", "relative_to": "out" },
