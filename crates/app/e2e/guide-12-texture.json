{
  "timeout_secs": 30,
  "steps": [
    { "op": "open_model", "path": "../../../target/tex/scene.glb" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "parts.row.0" },
    { "op": "sample", "label": "モデルの UV", "frames": 10 },
    { "op": "screenshot", "path": "texture-view.png" },
    { "op": "open_model", "path": "../../../target/tex/box.stl" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "parts.row.0" },
    { "op": "paste_texture", "path": "../../../target/tex/quadrants.png" },
    { "op": "wait_idle" },
    { "op": "click_widget", "name": "texture.size" },
    { "op": "key", "key": "A", "modifiers": ["command"] },
    { "op": "type_text", "text": "10" },
    { "op": "key", "key": "Enter" },
    { "op": "hover_view", "at": [0.85, 0.85] },
    { "op": "sample", "label": "箱形の投影", "frames": 10 },
    { "op": "screenshot", "path": "texture-paste.png" },
    { "op": "quit" }
  ]
}
